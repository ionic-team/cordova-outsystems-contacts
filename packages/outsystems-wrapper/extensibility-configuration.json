{
    "buildConfigurations": {
        "cordova": {
            "source": {
                "npm": "https://github.com/ionic-team/cordova-outsystems-contacts#1.1.0"
            }
        },
        "capacitor": {
            "source": {
                "npm": "@capacitor/contacts@1.1.0"
            }
        },
        "buildAction": {
            "config": "$resources.buildAction.json",
            "parameters": {
                "CONTACTS_PERMISSION_TYPE": "$extensibilitySettings.ContactsPermissionType"
            }
        }
    },
    "pluginConfigurations": {
        "cordova": {
            "preferences": {
                "android": {
                    "CONTACTS_PERMISSION_TYPE": "$extensibilitySettings.ContactsPermissionType"
                }
            }
        },
        "permissions": {
            "ios": {
                "NSContactsUsageDescription": {
                    "description": "$extensibilitySettings.ContactsUsageDescription"
                }
            }
        }
    },
    "metadata": {
        "mabs-min": "11.0.0",
        "name": "Contacts Plugin",
        "version": "2.1.0"
    }
}
